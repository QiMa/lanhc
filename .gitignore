# Binaries for programs and plugins
*~
*.tmp
*.dll
*.so
*.dylib
*.spk

*.exe
# tool/go.exe is built specially and committed.
!/tool/go.exe

cmd/lanhc/lanhc
cmd/lanhcd/lanhcd
ssh/tailssh/testcontainers/lanhcd

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# direnv config, this may be different for other people so it's probably safer
# to make this nonspecific.
.envrc

# Ignore personal VS Code settings
.vscode/

# Support personal project-specific GOPATH
.gopath/

# Ignore nix build result path
/result

# Ignore direnv nix-shell environment cache
.direnv/

# Ignore web client node modules
.vite/
client/web/node_modules

/gocross
/dist

# Ignore xcode userstate and workspace data
*.xcuserstate
*.xcworkspacedata
/tstest/tailmac/bin
/tstest/tailmac/build

# Ignore personal IntelliJ settings
.idea/

# Ignore syncthing state directory.
/.stfolder
# Binaries produced by `go build ./cmd/fbstatus` and `./cmd/gafpush`.
# Anchored so they don't hide the cmd/ source directories.
/fbstatus
/gafpush
# Binary produced by `go build ./cmd/lanhc-agent`.
# Anchored so it doesn't hide the cmd/lanhc-agent source directory.
/lanhc-agent
